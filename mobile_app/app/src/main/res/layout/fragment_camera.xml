<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F0F0">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Video Surveillance"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Camera 1 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/camera1Container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/camera2Container"
        app:layout_constraintBottom_toTopOf="@id/camera3Container"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintVertical_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <WebView
                android:id="@+id/camera1WebView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3"/>

            <Button
                android:id="@+id/camera1Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fullscreen"
                android:textColor="@android:color/white"
                android:background="@android:color/holo_blue_dark"/>
        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Camera 2 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/camera2Container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintStart_toEndOf="@id/camera1Container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/camera4Container"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintVertical_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <WebView
                android:id="@+id/camera2WebView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3"/>

            <Button
                android:id="@+id/camera2Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fullscreen"
                android:textColor="@android:color/white"
                android:background="@android:color/holo_blue_dark"/>
        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Camera 3 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/camera3Container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/camera1Container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/camera4Container"
        app:layout_constraintBottom_toTopOf="@id/camera5Container"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintVertical_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <WebView
                android:id="@+id/camera3WebView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3"/>

            <Button
                android:id="@+id/camera3Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fullscreen"
                android:textColor="@android:color/white"
                android:background="@android:color/holo_blue_dark"/>
        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Camera 4 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/camera4Container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/camera2Container"
        app:layout_constraintStart_toEndOf="@id/camera3Container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/camera5Container"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintVertical_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <WebView
                android:id="@+id/camera4WebView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3"/>

            <Button
                android:id="@+id/camera4Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fullscreen"
                android:textColor="@android:color/white"
                android:background="@android:color/holo_blue_dark"/>
        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Camera 5 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/camera5Container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/camera3Container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintVertical_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <WebView
                android:id="@+id/camera5WebView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3"/>

            <Button
                android:id="@+id/camera5Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fullscreen"
                android:textColor="@android:color/white"
                android:background="@android:color/holo_blue_dark"/>
        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
